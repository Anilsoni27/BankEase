# ==============================================================================
# BankEase Deployment Environment Variables Template
# Copy this file to '.env' and populate with your production secrets:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Mandatory Security Credentials
# ------------------------------------------------------------------------------
# Cryptographically secure 256-bit secret key used for HMAC-SHA256 JWT tokens.
# Must be at least 32 characters in length.
# Generate on Linux/macOS: openssl rand -base64 48
# Generate on Windows:     [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }))
JWT_SECRET=ReplaceWithYourSecureSecretKeyAtLeast32CharactersLong2026!

# MySQL Root User Password
DB_PASSWORD=YourStrongDatabasePasswordHere

# ------------------------------------------------------------------------------
# 2. Database Connection Options (Choose Option A or Option B)
# ------------------------------------------------------------------------------
# Option A: Standard host and port parameters
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bankease_db
DB_USERNAME=root

# Option B: Complete JDBC connection URL (used by Cloud providers e.g. Render, Railway, AWS RDS)
# DB_URL=jdbc:mysql://your-db-host:3306/bankease_db?createDatabaseIfNotExist=true&useSSL=true&serverTimezone=UTC

# ------------------------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------------------------
# Application listening port (Cloud platforms automatically inject $PORT)
PORT=8080

# Production CORS Allowed Origins (Comma-separated list of trusted client URLs)
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:4200,https://yourdomain.com

# ------------------------------------------------------------------------------
# 4. Feature & Compliance Flags
# ------------------------------------------------------------------------------
# Set to 'false' in production so demo accounts are not seeded
SEED_ENABLED=false

# Set to 'false' in production so OTPs are sent via SMS/Email rather than exposed in response
OTP_DEMO_MODE=false

# Default daily compliance limit in INR (default ₹100,000.00)
DEFAULT_DAILY_LIMIT=100000.00

# Database Hibernate DDL (use 'update' or 'validate' in production)
DDL_AUTO=update

